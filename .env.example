# Kopieer naar .env en vul je eigen token in. .env staat in .gitignore.
ICTRECHT_API_BASE_URL=https://proxy.ai.ictrecht.nl/api
ICTRECHT_API_TOKEN=
# Map voor de API-log (één JSON-regel per call). Leeg laten = logging uit.
ICTRECHT_API_LOG_DIR=logs
# Time-out per API-call in seconden (standaard 300).
ICTRECHT_API_TIMEOUT=300
# Naam voor 'Uitgevoerd door' bij testregister.py run en standaardnaam in het beheerscherm (standaard: API-script).
ICTRECHT_TESTER=
# OpenWebUI-model dat testruns beoordeelt (testregister.py beoordeel).
ICTRECHT_JUDGE_MODEL=

# --- Database --------------------------------------------------------------
# Leeg = lokaal SQLite-bestand data/testregister.db. In Docker wordt DATABASE_URL door docker-compose gezet.
# CLI buiten Docker tegen de Postgres-container:
# DATABASE_URL=postgresql+psycopg://testregister:testregister@localhost:5432/testregister
# Centrale database: zet hier de URL van de server (met eigen wachtwoord).
DATABASE_URL=
# Wachtwoord van de Postgres-container (docker compose). Wijzig dit vóór de eerste start bij een centrale installatie.
POSTGRES_PASSWORD=testregister

# --- Beheerscherm ------------------------------------------------------------
# Optioneel wachtwoord voor het beheerscherm (aanbevolen als het centraal draait).
GUI_WACHTWOORD=
# Docker: poort en adres waarop het beheerscherm luistert (standaard 127.0.0.1:8501).
# GUI_ADRES=0.0.0.0
# GUI_POORT=8501
